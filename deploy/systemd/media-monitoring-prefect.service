[Unit]
Description=每日新聞監測 Prefect 排程（02:00、05:00、07:30 三輪，05:00 起寄候選總覽信）
After=prefect-server.service
Requires=prefect-server.service

[Service]
WorkingDirectory=%h/GitHub/media-monitoring
Environment=PREFECT_API_URL=http://127.0.0.1:4200/api
Environment="MM_TIMES=0 2,0 5,30 7"
Environment=MM_SEND_EMAIL=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# 2026-10-05 起取代 crontab 的三輪；08:00 保險檢查仍在 crontab（bin/watchdog.py）
ExecStart=%h/.local/bin/uv run --quiet --with prefect==3.8.7 --with 'sqlalchemy<2.1' --with pyyaml python bin/prefect_flow.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
